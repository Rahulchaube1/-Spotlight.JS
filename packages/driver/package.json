{
  "name": "spotlight.js",
  "license": "MIT",
  "private": false,
  "version": "1.10.2",
  "description": "The modern, zero-dependency JavaScript engine for interactive product tours, multi-element spotlights, tour persistence, and onboarding checklists.",
  "main": "./dist/spotlight.js.cjs",
  "module": "./dist/spotlight.js.mjs",
  "types": "./dist/spotlight.js.d.ts",
  "homepage": "https://Spotlightjs.rahulchaube1.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahulchaube1/-Spotlight.JS.git",
    "directory": "packages/driver"
  },
  "author": "Rahul Chaube <https://rahulchaube1.com>",
  "bugs": {
    "url": "https://github.com/Rahulchaube1/-Spotlight.JS/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/spotlight.js.d.mts",
        "default": "./dist/spotlight.js.mjs"
      },
      "require": {
        "types": "./dist/spotlight.js.d.cts",
        "default": "./dist/spotlight.js.cjs"
      }
    },
    "./hints": {
      "import": {
        "types": "./dist/hints.d.mts",
        "default": "./dist/hints.mjs"
      },
      "require": {
        "types": "./dist/hints.d.cts",
        "default": "./dist/hints.cjs"
      }
    },
    "./checklist": {
      "import": {
        "types": "./dist/checklist.d.mts",
        "default": "./dist/checklist.mjs"
      },
      "require": {
        "types": "./dist/checklist.d.cts",
        "default": "./dist/checklist.cjs"
      }
    },
    "./dist/spotlight.css": {
      "import": "./dist/spotlight.css",
      "require": "./dist/spotlight.css",
      "default": "./dist/spotlight.css"
    },
    "./dist/driver.css": {
      "import": "./dist/driver.css",
      "require": "./dist/driver.css",
      "default": "./dist/driver.css"
    },
    "./dist/hints.css": {
      "import": "./dist/hints.css",
      "require": "./dist/hints.css",
      "default": "./dist/hints.css"
    },
    "./dist/checklist.css": {
      "import": "./dist/checklist.css",
      "require": "./dist/checklist.css",
      "default": "./dist/checklist.css"
    }
  },
  "scripts": {
    "build": "tsc && tsdown && node scripts/postbuild.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint && attw --pack . --exclude-entrypoints ./dist/driver.css ./dist/hints.css ./dist/checklist.css",
    "release": "release-it",
    "prepublishOnly": "pnpm build && pnpm lint:package"
  },
  "files": [
    "!tests/**/*",
    "dist/**/*",
    "hints/package.json",
    "checklist/package.json",
    "!dist/**/*.js.map"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@release-it/keep-a-changelog": "^7.1.0",
    "@tsdown/css": "^0.22.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "publint": "^0.3.21",
    "release-it": "^20.2.0",
    "tsdown": "^0.22.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "spotlight.js",
    "spotlight",
    "driver.js",
    "product tour",
    "user onboarding",
    "tour",
    "guide",
    "walkthrough",
    "interactive tour",
    "multi-element spotlight",
    "tour persistence",
    "onboarding checklist",
    "hints",
    "popover",
    "tooltip",
    "react-tour",
    "vue-tour",
    "svelte-tour",
    "vanilla js tour"
  ]
}
