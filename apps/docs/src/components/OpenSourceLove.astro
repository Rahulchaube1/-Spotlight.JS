---
import Container from "./Container.astro";
---
<div class="py-16 md:py-24 bg-card text-foreground border-t border-border">
  <Container>
    <div class="flex flex-col lg:flex-row items-center justify-between gap-10">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold text-foreground mb-4">
          <span>100% Free &amp; Open Source</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-foreground tracking-tight">Built for the Global Developer Community</h2>
        <p class="text-base md:text-xl text-muted-foreground mb-8 leading-relaxed">
          Spotlight.js is an <span class="font-semibold text-foreground">MIT-licensed</span> open-source project created and maintained by <a href="https://rahulchaube1.com" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold underline underline-offset-4 hover:opacity-80 transition-colors">Rahul Chaube</a>. Free forever for personal and commercial applications.
        </p>

        <div class="flex flex-wrap gap-3.5">
          <a href="https://github.com/Rahulchaube1/-Spotlight.JS"
             data-github-link
             target="_blank"
             rel="noopener noreferrer"
             class="flex justify-center items-center font-semibold text-sm sm:text-base rounded-xl py-3 px-5 bg-primary text-primary-foreground shadow-sm hover:opacity-90 active:scale-[0.98] transition-all">
            <span class="mr-2 inline-flex items-center"><img src="/star.svg" alt="Star" class="h-4 w-4 mr-1.5 invert" /></span>
            Star on GitHub
          </a>
          <a href="https://buymeacoffee.com/rahulchaube"
             target="_blank"
             rel="noopener noreferrer"
             class="flex justify-center items-center font-semibold text-sm sm:text-base rounded-xl py-3 px-5 border border-border bg-card text-foreground shadow-xs hover:bg-muted hover:border-primary/50 active:scale-[0.98] transition-all">
            ☕ Sponsor Project
          </a>
          <a href="/docs/installation"
             class="flex justify-center items-center font-semibold text-sm sm:text-base rounded-xl py-3 px-5 border border-border bg-muted text-foreground hover:bg-muted/80 active:scale-[0.98] transition-all">
            Get Started &rarr;
          </a>
        </div>
      </div>
      <div class="hidden lg:flex items-center justify-center p-8 rounded-3xl bg-primary/5 border border-primary/20">
        <img src="/thumbs.svg" alt="Thumbs Up" class="h-32 w-auto object-contain opacity-90" />
      </div>
    </div>
  </Container>
</div>
