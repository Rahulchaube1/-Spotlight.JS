---
import Container from "./Container.astro";

const companies = [
  { name: "Red Hat", logo: "/companies/redhat.svg", h: "h-10" },
  { name: "Alibaba", logo: "/companies/alibaba.svg", h: "h-8" },
  { name: "MIT", logo: "/companies/mit.svg", h: "h-8" },
  { name: "Ethereum", logo: "/companies/ethereum.svg", h: "h-9" },
  { name: "GitKraken", logo: "/companies/gitkraken.svg", h: "h-11" },
  { name: "Apache", logo: "/companies/apache.svg", h: "h-10" },
  { name: "Intel", logo: "/companies/intel.svg", h: "h-16" },
  { name: "Fiverr", logo: "/companies/fiverr.svg", h: "h-[5.5rem]" },
];
---

<div class="bg-card border-b border-border py-8 md:py-10">
  <Container>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 md:gap-x-14">
      {
        companies.map(c => (
          <div class="group relative flex items-center justify-center">
            <img
              src={c.logo}
              alt={c.name}
              class={`w-auto opacity-60 grayscale transition duration-200 group-hover:opacity-100 group-hover:grayscale-0 ${c.h}`}
            />
            <span class="pointer-events-none absolute bottom-1/2 left-1/2 mb-8 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-secondary text-secondary-foreground px-2.5 py-1 text-xs font-medium opacity-0 transition duration-200 group-hover:translate-y-0 group-hover:opacity-100 shadow-sm">
              {c.name}
              <span class="absolute left-1/2 top-full -mt-px h-2 w-2 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-secondary" />
            </span>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-7 max-w-2xl text-center text-sm md:text-base text-muted-foreground font-medium">
      Built for <span class="text-foreground font-semibold px-2 py-0.5 rounded-md bg-muted">universal compatibility</span> with <span class="text-foreground font-semibold px-2 py-0.5 rounded-md bg-muted">zero external dependencies</span>.
    </p>
  </Container>
</div>
