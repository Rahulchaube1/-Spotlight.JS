---
import Container from "./Container.astro";
---

<div class="py-16 md:py-24 bg-background border-t border-border">
  <Container>
    <div class="relative overflow-hidden rounded-3xl border border-border bg-card p-8 md:p-14 text-center shadow-sm">
      <div class="mx-auto flex justify-center mb-6">
        <div class="p-3 bg-muted/60 rounded-2xl border border-border/50">
          <img
            src="/Spotlightjs.png"
            alt="Spotlight.js logo"
            class="h-20 md:h-28 w-auto object-contain rounded-xl"
          />
        </div>
      </div>

      <h2 class="text-3xl md:text-5xl font-black text-foreground max-w-xl mx-auto leading-tight">
        Ship your first spotlight tour today
      </h2>
      <p class="mt-4 text-base md:text-xl text-muted-foreground max-w-lg mx-auto font-normal">
        A few lines of code is all it takes. No dependencies, zero bloat, pure Spotlight.js.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3.5 items-center justify-center">
        <a
          href="/docs/installation"
          class="w-full sm:w-auto cursor-pointer rounded-xl bg-primary text-primary-foreground px-8 py-3.5 text-center text-base md:text-lg font-semibold shadow-sm transition-all hover:opacity-90 focus:outline-none"
        >
          Get Started &rarr;
        </a>
        <a
          href="https://github.com/Rahulchaube1/-Spotlight.JS"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-secondary text-secondary-foreground px-7 py-3.5 text-center text-base md:text-lg font-semibold shadow-sm transition-all hover:bg-secondary/90 focus:outline-none"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" class="h-4 w-4">
            <path
              d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.785 1.401 8.166L12 18.896l-7.335 3.866 1.401-8.166L.132 9.21l8.2-1.192z"
            ></path>
          </svg>
          Star on GitHub
        </a>
        <a
          href="https://buymeacoffee.com/rahulchaube"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-border bg-background px-6 py-3.5 text-center text-base md:text-lg font-semibold text-foreground shadow-xs transition-all hover:bg-muted/60 focus:outline-none"
        >
          <span>☕</span>
          <span>Buy Me a Coffee</span>
        </a>
      </div>
    </div>
  </Container>
</div>
