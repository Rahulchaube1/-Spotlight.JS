---
import { Code } from "astro:components";
import Container from "./Container.astro";

const tabs = [
  {
    name: "Product Tour",
    code: `import { spotlight } from "spotlight.js";
import "spotlight.js/dist/spotlight.css";

const tour = spotlight({
  showProgress: true,
  sound: true,
  celebrateOnDone: true,
  theme: "dark",
  steps: [
    {
      element: "#search",
      popover: { title: "Search", description: "Find anything in seconds." },
    },
    {
      element: "#notifications",
      popover: { title: "Stay updated", description: "All your alerts live here." },
    },
    {
      element: "#profile",
      popover: { title: "Your account", description: "Manage settings and billing." },
    },
  ],
});

tour.drive();`,
  },
  {
    name: "Single Highlight",
    code: `import { spotlight } from "spotlight.js";
import "spotlight.js/dist/spotlight.css";

const tour = spotlight();

tour.highlight({
  element: "#new-feature",
  popover: {
    title: "New: Spotlight 2.0 🌟",
    description: "Multi-element spotlights, Web Audio chimes, and confetti celebration.",
  },
});`,
  },
  {
    name: "Hints",
    code: `import { hints } from "spotlight.js/hints";
import "spotlight.js/dist/hints.css";

const productHints = hints({
  hints: [
    {
      element: "#export-btn",
      popover: { title: "New: Export", description: "Download reports as CSV or PDF." },
    },
    {
      element: "#filters",
      popover: { title: "Filters", description: "Narrow results by date or owner." },
    },
  ],
});

productHints.show();`,
  },
  {
    name: "Checklist",
    code: `import { checklist } from "spotlight.js/checklist";
import "spotlight.js/dist/spotlight.css";
import "spotlight.js/dist/checklist.css";

const onboarding = checklist({
  id: "onboarding",
  items: [
    { id: "tour", title: "Take the tour", tour: steps },
    { id: "invite", title: "Invite a teammate", action: openInviteModal },
    { id: "github", title: "Connect GitHub", completeWhen: () => user.githubConnected },
  ],
});

onboarding.show();`,
  },
  {
    name: "Visual Tour Builder",
    code: `import { spotlight } from "spotlight.js";
import "spotlight.js/dist/spotlight.css";

const tour = spotlight();

// Launch interactive point-and-click step recorder
tour.startTourBuilder();`,
  },
];
---

<div class="bg-card border-t border-border py-12 md:py-20 text-foreground">
  <Container>
    <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold text-foreground mb-3">
      <span>Developer Experience</span>
    </div>
    <h2 class="text-3xl md:text-4xl font-bold mb-2 md:mb-3 text-foreground">Your first tour in seconds 🚀</h2>
    <p class="text-base text-muted-foreground md:text-lg mb-8 md:mb-10 leading-relaxed">
      Import Spotlight.js, declare your tour steps, and call <code class="rounded bg-muted px-1.5 py-0.5 text-sm font-mono text-foreground border border-border">drive()</code>. Hints, checklists, and the tour builder follow the same effortless API.
    </p>

    <div id="code-showcase" class="overflow-hidden rounded-2xl border border-border bg-[#0f172a] shadow-md">
      <div class="flex flex-wrap gap-2 p-3 pb-4 md:gap-2.5 md:p-4 md:pb-5 border-b border-white/10 bg-slate-900/60">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              data-code-tab={i}
              class:list={[
                "code-tab cursor-pointer rounded-xl border px-4 py-2 text-sm font-semibold transition-all md:px-5 md:py-2",
                i === 0
                  ? "border-primary bg-primary text-primary-foreground shadow-xs"
                  : "border-transparent bg-white/10 text-gray-300 hover:bg-white/15 hover:text-white",
              ]}
            >
              {tab.name}
            </button>
          ))
        }
      </div>

      <div class="overflow-x-auto px-4 pb-5 pt-3 md:px-6 md:pb-6">
        {
          tabs.map((tab, i) => (
            <div data-code-panel={i} class:list={[i === 0 ? "block" : "hidden"]}>
              <Code code={tab.code} lang="js" theme="monokai" />
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</div>

<style is:global>
  #code-showcase pre.astro-code {
    margin: 0;
    background: transparent !important;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    #code-showcase pre.astro-code {
      font-size: 1rem;
    }
  }
</style>

<script>
  const root = document.getElementById("code-showcase");

  if (root) {
    const activeClasses = ["border-primary", "bg-primary", "text-primary-foreground", "shadow-xs"];
    const inactiveClasses = ["border-transparent", "bg-white/10", "text-gray-300", "hover:bg-white/15", "hover:text-white"];

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-code-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-code-panel]"));

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const index = tab.dataset.codeTab;

        tabs.forEach((other) => {
          const active = other.dataset.codeTab === index;
          other.classList.remove(...activeClasses, ...inactiveClasses);
          other.classList.add(...(active ? activeClasses : inactiveClasses));
        });

        panels.forEach((panel) => {
          const active = panel.dataset.codePanel === index;
          panel.classList.toggle("block", active);
          panel.classList.toggle("hidden", !active);
        });
      });
    });
  }
</script>
