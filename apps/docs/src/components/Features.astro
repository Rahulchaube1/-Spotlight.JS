---
import { Earth, Smartphone, Settings, Feather, Code2, Layers, Keyboard } from "lucide-react";
import Container from "./Container.astro";
---

<div class="py-16 md:py-24 bg-card border-y border-border">
  <Container>
    <div class="max-w-screen-lg mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-foreground mb-4">Engineered for Delightful User Onboarding</h2>
      <p class="text-base md:text-xl text-muted-foreground">
        Lightweight with zero external dependencies, highly customizable, and battle-tested for all modern browsers.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Earth className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Universal Compatibility</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Works seamlessly across Chrome, Edge, Safari, Firefox, and mobile WebKit with zero polyfills required.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Smartphone className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Responsive &amp; Touch Ready</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Smooth viewport tracking and pinch/touch gestures for desktops, tablets, and smartphones.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Settings className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Infinitely Customizable</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Granular lifecycle hooks, custom HTML popover renderers, CSS transitions, and SVG path filters.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Feather className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Ultra Lightweight</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Microscopic bundle size that keeps your application lightning-fast and respects users' bandwidth.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Code2 className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Zero Dependencies</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Pure vanilla JavaScript &amp; TypeScript. No bloated runtime, no React/Vue lock-in, runs everywhere.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Layers className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Multi-Cutout Spotlights</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Highlight multiple DOM elements simultaneously using single-pass compound SVG overlay paths.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary font-bold">
          FX
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Audio &amp; Confetti</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Built-in Web Audio synthesis sound effects and physics-driven particle confetti celebrations.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Code2 className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Visual Tour Builder</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Interactive point-and-click studio to record element tours in real-time and export code instantly.
        </p>
      </div>

      <div class="group rounded-2xl border border-border bg-card p-6 shadow-xs transition-all hover:border-primary/50 hover:shadow-md">
        <div class="flex justify-center items-center mb-4 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 text-primary">
          <Keyboard className="w-6 h-6" />
        </div>
        <h3 class="mb-2 text-lg md:text-xl font-bold text-foreground">Accessible Keyboard Nav</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Full ARIA role management, trap-focus accessibility, and intuitive Arrow/Escape keybindings.
        </p>
      </div>
    </div>
  </Container>
</div>
