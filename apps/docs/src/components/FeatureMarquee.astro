---
const features = [
  "Supports all Major Browsers",
  "Works on Mobile Devices",
  "Audio Synthesizer FX",
  "Confetti Celebrations",
  "Interactive Tour Builder",
  "Multi-Cutout Spotlights",
  "Highly Customizable",
  "Light-weight",
  "Zero Dependencies",
  "Tours, Highlights & Hints",
  "MIT Licensed",
  "Written in TypeScript",
  "Vanilla JavaScript",
  "Frameworks Ready",
  "Fully Accessible",
];
---

<div class="bg-secondary text-secondary-foreground border-y border-border/20 overflow-hidden select-none">
  <div class="marquee-track flex h-12 w-max items-center md:h-14">
    {
      [0, 1].map(copy => (
        <div class="flex items-center" aria-hidden={copy === 1}>
          {features.map(feature => (
            <span class="flex items-center">
              <span class="whitespace-nowrap px-6 text-sm font-medium tracking-wide text-secondary-foreground md:text-base">{feature}</span>
              <span class="h-1.5 w-1.5 rounded-full bg-primary" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee-scroll 32s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
