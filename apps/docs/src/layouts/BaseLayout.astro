---
import Analytics from "../components/Analytics/Analytics.astro";
import WebMcpTools from "../components/WebMcpTools.astro";
import "../styles/tailwind.css";
import "../styles/checklist-themes/brutalist.css";
export interface Props {
  permalink?: string;
  title?: string;
  description?: string;
}

const {
  permalink = "",
  title = "Spotlight.js",
  description = "A powerful, zero-dependency, vanilla JavaScript library to spotlight elements and drive interactive user tours.",
} = Astro.props;

const canonical = new URL(permalink, Astro.site ?? "https://Spotlightjs.rahulchaube1.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{title}</title>
    <meta name="robots" content="index,follow" />
    <meta name="description" itemprop="description" content={description} />

    <link href={canonical} rel="canonical" />

    <meta content="Rahul Chaube" name="author" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="@rahulchaube" name="twitter:creator" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content="https://Spotlightjs.rahulchaube1.com/Spotlightjs.png" name="twitter:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content="https://Spotlightjs.rahulchaube1.com/Spotlightjs.png" property="og:image" />
    <meta content="Spotlight.js — powerful JavaScript library for product tours, spotlights, and hints" property="og:image:alt" />
    <meta content="Spotlight.js" property="og:site_name" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content="en_US" property="og:locale" />
    <meta content={canonical} property="og:url" />

    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="32x32" href="/Spotlightjs.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/Spotlightjs.png" />
    <link rel="icon" type="image/png" href="/Spotlightjs.png" />
    <link rel="shortcut icon" href="/Spotlightjs.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/Spotlightjs.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full docs for LLMs" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <slot name="head" />

    <style is:global>
      .spotlight-popover.spotlight-theme,
      .spotlight-popover.driverjs-theme,
      .driver-popover.driverjs-theme {
        background-color: var(--card, #ffffff);
        color: var(--foreground, #1e293b);
        border: 1px solid var(--border, #e2e8f0);
        border-radius: var(--radius, 0.75rem);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        padding: 18px;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-title,
      .spotlight-popover.driverjs-theme .driver-popover-title,
      .driver-popover.driverjs-theme .driver-popover-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--foreground, #1e293b);
        letter-spacing: -0.01em;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-description,
      .spotlight-popover.driverjs-theme .driver-popover-description,
      .driver-popover.driverjs-theme .driver-popover-description {
        color: var(--muted-foreground, #64748b);
        font-size: 14px;
        line-height: 1.6;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-progress-text,
      .spotlight-popover.driverjs-theme .driver-popover-progress-text,
      .driver-popover.driverjs-theme .driver-popover-progress-text {
        color: var(--muted-foreground, #64748b);
        font-size: 12px;
        font-weight: 600;
      }

      .spotlight-popover.spotlight-theme button:not(.spotlight-popover-close-btn),
      .spotlight-popover.driverjs-theme button:not(.driver-popover-close-btn),
      .driver-popover.driverjs-theme button:not(.driver-popover-close-btn) {
        flex: 1;
        text-align: center;
        background-color: var(--primary, #0ea5e9);
        color: var(--primary-foreground, #ffffff);
        border: none;
        text-shadow: none;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: calc(var(--radius, 0.75rem) - 4px);
        transition: opacity 0.15s ease;
      }

      .spotlight-popover.spotlight-theme button:not(.spotlight-popover-close-btn):focus,
      .spotlight-popover.spotlight-theme button:not(.spotlight-popover-close-btn):hover,
      .driver-popover.driverjs-theme button:not(.driver-popover-close-btn):focus,
      .driver-popover.driverjs-theme button:not(.driver-popover-close-btn):hover {
        opacity: 0.9;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-navigation-btns,
      .driver-popover.driverjs-theme .driver-popover-navigation-btns {
        justify-content: space-between;
        gap: 6px;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-footer,
      .driver-popover.driverjs-theme .driver-popover-footer {
        gap: 12px;
        margin-top: 14px;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-progress-text,
      .driver-popover.driverjs-theme .driver-popover-progress-text {
        white-space: nowrap;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-footer button.spotlight-popover-btn-disabled,
      .driver-popover.driverjs-theme .driver-popover-footer button.driver-popover-btn-disabled {
        background-color: var(--muted, #f1f5f9);
        color: var(--muted-foreground, #94a3b8);
        border: 1px solid var(--border, #e2e8f0);
        opacity: 0.7;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-close-btn,
      .driver-popover.driverjs-theme .driver-popover-close-btn {
        color: var(--muted-foreground, #94a3b8);
        transition: color 0.15s ease;
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-close-btn:hover,
      .driver-popover.driverjs-theme .driver-popover-close-btn:hover {
        color: var(--foreground, #1e293b);
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-arrow-side-left.spotlight-popover-arrow,
      .driver-popover.driverjs-theme .driver-popover-arrow-side-left.driver-popover-arrow {
        border-left-color: var(--card, #ffffff);
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-arrow-side-right.spotlight-popover-arrow,
      .driver-popover.driverjs-theme .driver-popover-arrow-side-right.driver-popover-arrow {
        border-right-color: var(--card, #ffffff);
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-arrow-side-top.spotlight-popover-arrow,
      .driver-popover.driverjs-theme .driver-popover-arrow-side-top.driver-popover-arrow {
        border-top-color: var(--card, #ffffff);
      }

      .spotlight-popover.spotlight-theme .spotlight-popover-arrow-side-bottom.spotlight-popover-arrow,
      .driver-popover.driverjs-theme .driver-popover-arrow-side-bottom.driver-popover-arrow {
        border-bottom-color: var(--card, #ffffff);
      }

      .docs-checklist-green {
        --spotlight-checklist-color: #16a34a;
        --driver-checklist-color: #16a34a;
      }

      /* Beacon classes used by the samples on the hints examples page. */
      .docs-hint-rose {
        --spotlight-hint-color: #e11d48;
        --driver-hint-color: #e11d48;
      }

      .docs-hint-large {
        --spotlight-hint-color: #059669;
        --driver-hint-color: #059669;
        --spotlight-hint-size: 28px;
        --driver-hint-size: 28px;
      }
    </style>
  </head>
  <body>
    <slot />
    <Analytics />
    <WebMcpTools />
  </body>
</html>
